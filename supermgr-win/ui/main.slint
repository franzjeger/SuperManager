// SuperManager for Windows.
//
// Layout follows Windows 11's own apps: a navigation pane on the window's
// Mica-coloured base, pages on a lighter layer, dialogs over a scrim. The
// std widgets are Slint's fluent style, which tracks the Windows light/dark
// setting and accent colour; `Theme` (theme.slint) gives everything else
// the same colours.
//
// State lives in globals (state.slint) that the Rust side fills and
// answers; pages read them directly.

import { Button, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { App, ConfirmAction, ConnState, Overlay, Page, ToastKind, Vpn, Hosts, Keys, Updates } from "state.slint";
import { DangerButton, DialogButtons, InfoBar, NavItem, Severity, Sheet } from "widgets.slint";
import { AddProfileSheet, RenameProfileSheet, VpnPage } from "vpn.slint";
import { AddHostSheet, HostChoices, HostsPage } from "hosts.slint";
import { GenerateKeySheet, KeysPage } from "keys.slint";
import { SettingsPage } from "settings.slint";

export { App, Vpn, Hosts, Keys, Updates, HostChoices }
export { ConnState, ConfirmAction, Overlay, Page, ProfileKind, ToastKind, ProfileItem, HostItem, HostInfo, KeyItem } from "state.slint";

export component AppWindow inherits Window {
    title: "SuperManager";
    icon: @image-url("../../contrib/icons/hicolor/256.png");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.window;
    default-font-size: 14px;

    // Force light or dark. "Use Windows setting" is the style's default
    // binding, which the Rust side leaves alone unless the operator
    // changes their mind mid-session (see `App.appearance`).
    public function set-color-scheme(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    // WinUI's NavigationView goes icon-only below about 1000px, leaving the
    // width to the page. Set on a change rather than bound: the pane's
    // width feeds the layout that decides the window's width, and a binding
    // from one to the other is a loop.
    property <bool> nav-compact: false;
    property <length> nav-width: nav-compact ? 60px : 248px;
    init => { self.nav-compact = self.width > 0 && self.width < 1000px; }
    changed width => { self.nav-compact = self.width < 1000px; }

    HorizontalLayout {
        // ── Navigation pane ──────────────────────────────────────────────
        VerticalLayout {
            width: root.nav-width;
            padding: 8px;
            padding-top: 12px;
            spacing: 4px;

            HorizontalLayout {
                padding-left: 12px;
                padding-bottom: 12px;
                spacing: 12px;
                height: 44px;
                Image {
                    source: Icons.app;
                    width: 24px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    accessible-role: none;
                }
                if !root.nav-compact: Text {
                    text: "SuperManager";
                    font-size: Theme.body;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }

            NavItem {
                compact: root.nav-compact;
                icon: Icons.vpn;
                text: "VPN";
                selected: App.page == Page.vpn;
                show-dot: Vpn.state != ConnState.disconnected;
                dot-color: Vpn.state == ConnState.connected ? Theme.success
                    : Vpn.state == ConnState.failed ? Theme.critical : Theme.caution;
                clicked => { App.page = Page.vpn; }
            }
            NavItem {
                compact: root.nav-compact;
                icon: Icons.hosts;
                text: "Hosts";
                trailing: Hosts.total > 0 ? Hosts.total : "";
                selected: App.page == Page.hosts;
                clicked => { App.page = Page.hosts; }
            }
            NavItem {
                compact: root.nav-compact;
                icon: Icons.keys;
                text: "SSH keys";
                trailing: Keys.items.length > 0 ? Keys.items.length : "";
                selected: App.page == Page.keys;
                clicked => { App.page = Page.keys; }
            }

            Rectangle { vertical-stretch: 1; }

            // Where the tunnel stands, from any page.
            if !root.nav-compact && Vpn.state != ConnState.disconnected && App.page != Page.vpn: Rectangle {
                height: status-layout.preferred-height;
                border-radius: Theme.control-radius;
                background: status-touch.has-hover ? Theme.subtle-hover : transparent;
                status-touch := TouchArea {
                    clicked => { App.page = Page.vpn; }
                }
                status-layout := VerticalLayout {
                    padding: 12px;
                    spacing: 2px;
                    Text {
                        text: Vpn.state == ConnState.connected ? "Connected"
                            : Vpn.state == ConnState.connecting ? (Vpn.auth-url != "" ? "Waiting for sign-in" : "Connecting…")
                            : Vpn.state == ConnState.disconnecting ? "Disconnecting…" : "Connection failed";
                        font-size: Theme.caption;
                        color: Vpn.state == ConnState.connected ? Theme.success
                            : Vpn.state == ConnState.failed ? Theme.critical : Theme.caution;
                    }
                    Text {
                        text: Vpn.state-profile-name;
                        font-size: Theme.body;
                        color: Theme.text;
                        overflow: elide;
                    }
                }
            }

            NavItem {
                compact: root.nav-compact;
                icon: Icons.settings;
                text: "Settings";
                selected: App.page == Page.settings;
                show-dot: !App.daemon-online;
                dot-color: Theme.critical;
                clicked => { App.page = Page.settings; }
            }
        }

        // ── Content layer ────────────────────────────────────────────────
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.layer;
            border-top-left-radius: 8px;
            border-width: 1px;
            border-color: Theme.layer-stroke;

            VerticalLayout {
                if !App.daemon-online && App.page != Page.settings: HorizontalLayout {
                    padding-left: 32px;
                    padding-right: 32px;
                    padding-top: 16px;
                    InfoBar {
                        horizontal-stretch: 1;
                        severity: Severity.critical;
                        title: "The SuperManager service isn't running";
                        message: "Nothing here works without it. This window reconnects as soon as it is back.";
                        Button {
                            text: "Details";
                            y: (parent.height - self.height) / 2;
                            clicked => { App.page = Page.settings; }
                        }
                    }
                }
                if App.page == Page.vpn: VpnPage { vertical-stretch: 1; }
                if App.page == Page.hosts: HostsPage { vertical-stretch: 1; }
                if App.page == Page.keys: KeysPage { vertical-stretch: 1; }
                if App.page == Page.settings: SettingsPage { vertical-stretch: 1; }
            }
        }
    }

    // ── Toast ────────────────────────────────────────────────────────────
    if App.toast-visible: InfoBar {
        width: min(560px, root.width - 64px);
        height: self.preferred-height;
        x: root.nav-width + (root.width - root.nav-width - self.width) / 2;
        y: root.height - self.height - 24px;
        severity: App.toast-kind == ToastKind.error ? Severity.critical : Severity.success;
        message: App.toast-text;
        closable: true;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000030;
        closed => { App.dismiss-toast(); }
    }

    // ── Dialogs ──────────────────────────────────────────────────────────
    if App.overlay == Overlay.add-profile: AddProfileSheet {
        width: root.width;
        height: root.height;
    }
    if App.overlay == Overlay.rename-profile: RenameProfileSheet {
        width: root.width;
        height: root.height;
    }
    if App.overlay == Overlay.add-host: AddHostSheet {
        width: root.width;
        height: root.height;
    }
    if App.overlay == Overlay.generate-key: GenerateKeySheet {
        width: root.width;
        height: root.height;
    }
    if App.overlay == Overlay.confirm: Sheet {
        width: root.width;
        height: root.height;
        title: App.confirm-title;
        sheet-width: 460px;
        close => { App.close-overlay(); }

        Text {
            text: App.confirm-body;
            font-size: Theme.body;
            color: Theme.text;
            wrap: word-wrap;
        }
        DialogButtons {
            Button {
                text: "Cancel";
                init => { self.focus(); }
                clicked => { App.close-overlay(); }
            }
            DangerButton {
                text: App.confirm-button;
                clicked => {
                    if App.confirm-action == ConfirmAction.delete-profile {
                        Vpn.delete(App.confirm-target);
                    } else if App.confirm-action == ConfirmAction.delete-host {
                        Hosts.delete(App.confirm-target);
                    } else if App.confirm-action == ConfirmAction.delete-key {
                        Keys.delete(App.confirm-target);
                    } else if App.confirm-action == ConfirmAction.trust-host-key {
                        Hosts.trust-key(App.confirm-target);
                    } else if App.confirm-action == ConfirmAction.forget-host-key {
                        Hosts.forget-key(App.confirm-target);
                    }
                    App.close-overlay();
                }
            }
        }
    }
}
