// Building blocks shared by every page. Std widgets (Button, LineEdit, …)
// are used as they are; these cover what the fluent style has no widget
// for: the navigation pane, cards, status, and dialogs.

import { Button, ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";

// A row in the navigation pane (WinUI NavigationViewItem).
export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    in property <bool> show-dot;
    in property <color> dot-color;
    in property <string> trailing;
    // Icon only, for a narrow window (WinUI's compact pane).
    in property <bool> compact;
    callback clicked;

    height: 36px;
    border-radius: Theme.control-radius;
    background: touch.pressed ? Theme.subtle-pressed
        : root.selected ? Theme.subtle-selected
        : touch.has-hover ? Theme.subtle-hover : transparent;
    animate background { duration: 100ms; }

    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // The selection pill WinUI draws at the left edge.
    Rectangle {
        x: 0;
        width: 3px;
        height: root.selected ? 16px : 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 1.5px;
        background: Theme.accent;
        animate height { duration: 150ms; easing: ease-out; }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;

        Rectangle {
            width: 20px;
            Image {
                source: root.icon;
                colorize: Theme.text;
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
            }
            if root.show-dot: Rectangle {
                x: 12px;
                y: parent.height / 2 - 12px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.dot-color;
                border-width: 2px;
                border-color: Theme.window;
            }
        }
        if !root.compact: Text {
            text: root.text;
            font-size: Theme.body;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if !root.compact && root.trailing != "": Text {
            text: root.trailing;
            font-size: Theme.caption;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
    }
}

// A surface for a group of related content.
export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: Theme.card-stroke;
}

// Page title with room for the page's actions on the right.
export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    spacing: 12px;
    Text {
        text: root.title;
        font-size: Theme.title;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
        horizontal-stretch: 1;
        accessible-role: text;
    }
    @children
}

export component SectionTitle inherits Text {
    font-size: Theme.body;
    font-weight: 600;
    color: Theme.text;
}

// "Label        value" in a detail pane.
export component DetailRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> mono;
    spacing: 16px;
    Text {
        text: root.label;
        width: 150px;
        font-size: Theme.body;
        color: Theme.text-secondary;
    }
    Text {
        text: root.value;
        font-size: Theme.body;
        font-family: root.mono ? Theme.mono : "";
        color: Theme.text;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// A setting: what it does on the left, the control on the right.
export component OptionRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.title;
            font-size: Theme.body;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: Theme.caption;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }
    @children
}

export component StatusDot inherits Rectangle {
    in property <color> tint;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: root.tint;
}

// A small rounded label: a profile's type, a host's device type.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fill: Theme.subtle-selected;
    in property <color> ink: Theme.text-secondary;
    height: 22px;
    width: label.preferred-width + 16px;
    border-radius: 11px;
    background: root.fill;
    label := Text {
        text: root.text;
        font-size: Theme.caption;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A borderless button for secondary actions in rows and headers.
export component SubtleButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <color> ink: Theme.text;
    in property <bool> enabled: true;
    callback clicked;

    height: 32px;
    min-width: 32px;
    border-radius: Theme.control-radius;
    background: !root.enabled ? transparent
        : touch.pressed ? Theme.subtle-pressed
        : touch.has-hover ? Theme.subtle-hover : transparent;
    animate background { duration: 100ms; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: root.text == "" ? 8px : 10px;
        spacing: 8px;
        alignment: center;
        Image {
            source: root.icon;
            colorize: root.enabled ? root.ink : Theme.text-disabled;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
        }
        if root.text != "": Text {
            text: root.text;
            font-size: Theme.body;
            color: root.enabled ? root.ink : Theme.text-disabled;
            vertical-alignment: center;
        }
    }
}

// The one red button: delete, after asking.
export component DangerButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;

    height: 32px;
    min-width: max(96px, label.preferred-width + 32px);
    horizontal-stretch: 0;
    border-radius: Theme.control-radius;
    background: !root.enabled ? Theme.subtle-selected
        : touch.pressed ? Theme.danger-pressed
        : touch.has-hover ? Theme.danger-hover : Theme.danger;
    animate background { duration: 100ms; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        font-size: Theme.body;
        color: root.enabled ? #ffffff : Theme.text-disabled;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export enum Severity { info, success, caution, critical }

// A WinUI InfoBar: an icon for the severity, the message, and room for
// actions. Used inline and as the window's toast.
export component InfoBar inherits Rectangle {
    in property <Severity> severity: Severity.info;
    in property <string> title;
    in property <string> message;
    in property <bool> closable;
    callback closed;

    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: Theme.card-stroke;
    background: root.severity == Severity.success ? Theme.success-bg
        : root.severity == Severity.caution ? Theme.caution-bg
        : root.severity == Severity.critical ? Theme.critical-bg : Theme.info-bg;

    accessible-role: text;
    accessible-label: root.title + " " + root.message;

    HorizontalLayout {
        padding: 12px;
        padding-left: 16px;
        spacing: 12px;
        Image {
            source: root.severity == Severity.success ? Icons.success
                : root.severity == Severity.caution ? Icons.warning
                : root.severity == Severity.critical ? Icons.error : Icons.info;
            colorize: root.severity == Severity.success ? Theme.success
                : root.severity == Severity.caution ? Theme.caution
                : root.severity == Severity.critical ? Theme.critical : Theme.accent;
            width: 20px;
            height: 20px;
            y: 2px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;
            if root.title != "": Text {
                text: root.title;
                font-size: Theme.body;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.message != "": Text {
                text: root.message;
                font-size: Theme.body;
                color: Theme.text;
                wrap: word-wrap;
            }
        }
        @children
        if root.closable: SubtleButton {
            icon: Icons.dismiss;
            text: "";
            accessible-label: "Dismiss";
            clicked => { root.closed(); }
        }
    }
}

// What a page shows before there is anything on it.
export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> body;
    alignment: center;
    spacing: 12px;
    padding: 32px;
    HorizontalLayout {
        alignment: center;
        Image {
            source: root.icon;
            colorize: Theme.text-tertiary;
            width: 48px;
            height: 48px;
        }
    }
    Text {
        text: root.title;
        font-size: Theme.body-large;
        font-weight: 600;
        color: Theme.text;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    Text {
        text: root.body;
        font-size: Theme.body;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: center;
        padding-top: 4px;
        @children
    }
}

// A labelled form field: header above, hint below.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 6px;
    Text {
        text: root.label;
        font-size: Theme.body;
        color: Theme.text;
    }
    @children
    if root.hint != "": Text {
        text: root.hint;
        font-size: Theme.caption;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
}

// Command output: monospace, scrollable, selectable by copy.
export component Console inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.text;
    background: Theme.console;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: Theme.console-stroke;
    ScrollView {
        VerticalLayout {
            padding: 12px;
            alignment: start;
            Text {
                text: root.text;
                font-family: Theme.mono;
                font-size: 13px;
                color: root.ink;
                wrap: word-wrap;
            }
        }
    }
}

// A modal dialog over the window (WinUI ContentDialog). Escape closes it.
export component Sheet inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <length> sheet-width: 520px;
    callback close;

    background: Theme.scrim;

    // Nothing behind the dialog reacts while it is open.
    TouchArea { }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            return reject;
        }

        dialog := Rectangle {
            width: min(root.sheet-width, root.width - 48px);
            height: min(content.preferred-height, root.height - 48px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.card;
            border-radius: Theme.overlay-radius;
            border-width: 1px;
            border-color: Theme.card-stroke;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000045;

            accessible-role: groupbox;
            accessible-label: root.title;

            content := VerticalLayout {
                padding: 24px;
                spacing: 16px;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.title;
                        font-size: Theme.subtitle;
                        font-weight: 600;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    if root.subtitle != "": Text {
                        text: root.subtitle;
                        font-size: Theme.body;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
                @children
            }
        }
    }
}

// The row of buttons at the bottom of a dialog, right-aligned.
export component DialogButtons inherits HorizontalLayout {
    in property <string> error;
    spacing: 8px;
    padding-top: 8px;
    alignment: end;
    if root.error != "": Text {
        text: root.error;
        font-size: Theme.caption;
        color: Theme.critical;
        wrap: word-wrap;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    @children
}
