/* The installer explicitly grants daemon access through the supermgr group.
 * Local configuration/profile state queries and updates (manage) belong to
 * that role for an active local desktop user without repeated prompts.
 * Remote execution and SSH session staging (execute, ssh-connect) require
 * administrator authentication cached once per active session, while raw
 * credential exports and machine-wide routing/repair retain their own policy.
 */
polkit.addRule(function(action, subject) {
    if (!subject.local || !subject.active || !subject.isInGroup("supermgr")) {
        return undefined;
    }
    if (action.id === "org.supermgr.daemon.manage") {
        return polkit.Result.YES;
    }
    if (action.id === "org.supermgr.daemon.execute" ||
        action.id === "org.supermgr.daemon.ssh-connect") {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
});
