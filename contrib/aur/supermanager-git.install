start_strongswan() {
    local unit
    for unit in strongswan.service strongswan-swanctl.service strongswan-starter.service; do
        if systemctl enable --now "$unit" >/dev/null 2>&1; then
            echo "  strongSwan:       $unit enabled and running"
            return 0
        fi
    done
    echo "error: strongSwan was installed but its service could not be enabled" >&2
    return 1
}

# Non-fatal, unlike strongSwan: the daemon's Tailscale repair path can
# start this later from the GUI, so a failure here degrades to a button
# instead of failing the whole install.
start_tailscaled() {
    if systemctl enable --now tailscaled.service >/dev/null 2>&1; then
        echo "  Tailscale:        tailscaled enabled and running"
    else
        echo "  Tailscale:        tailscaled could not be enabled — the app's Tailscale page can repair this" >&2
    fi
}

post_install() {
    systemctl daemon-reload
    start_strongswan || return 1
    start_tailscaled
    systemctl enable --now supermgrd.service >/dev/null 2>&1 || true
    cat <<EOF

SuperManager installed.

  Launch GUI:        supermgr
  Daemon status:     systemctl status supermgrd
  Daemon logs:       journalctl -u supermgrd -f

Optional:
  - openvpn3 (AUR) for non-Azure OpenVPN profiles
  - networkmanager (enabled) for auto-connect on network change

EOF
}

post_upgrade() {
    systemctl daemon-reload
    start_strongswan || return 1
    start_tailscaled
    systemctl try-restart supermgrd.service >/dev/null 2>&1 || true
}

pre_remove() {
    systemctl disable --now supermgrd.service >/dev/null 2>&1 || true
}

post_remove() {
    systemctl daemon-reload
}
